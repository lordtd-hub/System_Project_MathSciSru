# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/project_assessment?schema=public"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Auth
# Auth.js v5 accepts AUTH_URL/AUTH_SECRET. NEXTAUTH_* is kept for compatibility with existing scripts.
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="change-me-dev-only"
NEXTAUTH_SECRET="change-me-dev-only"
# Set to true on Vercel or when running behind a trusted reverse proxy.
AUTH_TRUST_HOST="true"

# Initial admin setup
# Use your @sru.ac.th account here for the first admin.
INITIAL_ADMIN_EMAIL=""

# App config
APP_NAME="Project Presentation, Feedback & Evidence System"
STUDENT_EMAIL_DOMAIN="student.sru.ac.th"
TEACHER_EMAIL_DOMAIN="sru.ac.th"

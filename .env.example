# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/project_assessment?schema=public"
# Used by Prisma migrations. In local development this can match DATABASE_URL.
# In Supabase production, use the direct/non-pooling connection string.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/project_assessment?schema=public"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Auth
# Auth.js v5 accepts AUTH_URL/AUTH_SECRET. NEXTAUTH_* is kept for compatibility with existing scripts.
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="change-me-dev-only"
NEXTAUTH_SECRET="change-me-dev-only"
# Set to true on Vercel or when running behind a trusted reverse proxy.
AUTH_TRUST_HOST="true"

# Initial admin setup
# Use your @sru.ac.th account here for the first admin.
INITIAL_ADMIN_EMAIL=""

# App config
APP_NAME="Project Presentation, Feedback & Evidence System"
STUDENT_EMAIL_DOMAIN="student.sru.ac.th"
TEACHER_EMAIL_DOMAIN="sru.ac.th"

# Testing-only admin cleanup tools.
# Set to 1 only while testing before real production use. Remove or set to 0 before real rollout.
ENABLE_ADMIN_TEST_TOOLS="0"

# Preview/staging-only synthetic pilot login.
# Leave disabled in production. QA_LOGIN_ALLOW_PRODUCTION must stay unset unless temporarily approved.
ENABLE_QA_LOGIN="0"
QA_LOGIN_SECRET=""
QA_ADMIN_EMAIL=""
QA_TEACHER_EMAIL=""
QA_STUDENT_EMAIL=""
# QA_LOGIN_ALLOW_PRODUCTION="0"
